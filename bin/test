#!/bin/sh
# Airship's checks. Nothing here opens a window on the desktop: the first two
# steps run headless, and the frame is drawn on a virtual X display.
#   1. import the project, and make the sounds (tools/make_sounds.gd)
#   2. run the unit tests in tests/ headless
#   3. run the main scene headless for a few frames, so every script parses,
#      and play a train (then a silent one) headless
#   4. export the package's data file and run it from outside the project
#   5. draw a frame of a session under xvfb-run, save it and check it, and
#      a frame of the launch and one of the train waiting to trade
# Godot keeps going after most errors, so any ERROR or WARNING line in its
# output fails the run, except the one below.
set -eu
cd "$(dirname "$0")/.."
out=build/test
rm -rf "$out"
mkdir -p "$out"
# Godot leaves out any folder with a .gdignore: the tests' leftovers in
# build/ (a deliberately broken link among them) are never the project's.
touch build/.gdignore
# Godot's own files (logs, editor settings) go here, never in the home folder.
export XDG_DATA_HOME="$PWD/$out/xdg/data" XDG_CONFIG_HOME="$PWD/$out/xdg/config" XDG_CACHE_HOME="$PWD/$out/xdg/cache"

vsync='WARNING: Could not set V-Sync mode, as changing V-Sync mode is not supported by the graphics driver.'

run() { # name, then the command
    name=$1
    shift
    if ! "$@" >"$out/$name.log" 2>&1; then
        cat "$out/$name.log"
        echo "bin/test: $name failed"
        exit 1
    fi
    # A virtual X display can't change V-Sync; the desktop can. That warning
    # is the display's, not Airship's, so it alone is let through.
    # Godot prints some problems without either word, such as text it
    # couldn't decode.
    if grep -E 'ERROR|WARNING|Unicode parsing error' "$out/$name.log" | grep -vxF "$vsync"; then
        echo "bin/test: $name: Godot reported the problems above"
        exit 1
    fi
}

run import godot --headless --path . --import
# The distant sounds aren't committed: made here, as the package build makes
# them, then imported.
run sounds godot --headless --path . --script res://tools/make_sounds.gd
run import-sounds godot --headless --path . --import
# A test that never returns would hang the run; a minute is far more than they need.
run unit timeout 60 godot --headless --path . --script res://tests/run.gd
run parse godot --headless --path . --quit-after 5
# The sounds, headless with silent audio: a train asked for, given up on
# after it starts; it must start, then fade and stop, and its picture pass.
# Then the same at volume 0, which must play nothing (and say nothing
# wrong) while the picture still passes.
sounds_run() { # name, volume, then what the log must say
    name=$1
    volume=$2
    shift 2
    run "$name" env AIRSHIP_SOUND_TEST=train AIRSHIP_SOUND_VOLUME="$volume" AIRSHIP_WEATHER=clear \
        timeout 60 godot --headless --path . --audio-driver Dummy \
        -- --build=0 --give-up-at=5 --quit-at=9 --log-sounds
    if [ "$(grep -E '^(passing|sound):' "$out/$name.log" | tr '\n' ' ')" != "$*" ]; then
        cat "$out/$name.log"
        echo "bin/test: $name: expected the sounds to go: $*"
        exit 1
    fi
}
# The train's picture passes with its sound, and passes even unheard.
sounds_run sounds 1 "passing: train sound: train passing: stopped sound: stopped "
sounds_run silent 0 "passing: train passing: stopped "
# The package's data file, as pkgbuild/PKGBUILD makes it, run on its own from
# outside the project: in German, with a train, so a translation or a sound
# left out of the export fails here, not after installing.
run export godot --headless --path . --export-pack Linux "$PWD/$out/airship.pck"
mkdir -p "$out/elsewhere"
run packed sh -c "cd '$out/elsewhere' && AIRSHIP_LANGUAGE=de AIRSHIP_SOUND_TEST=train AIRSHIP_WEATHER=clear \
    timeout 60 godot --headless --main-pack ../airship.pck --audio-driver Dummy \
    -- --log-words --build=0 --give-up-at=5 --quit-at=8 --log-sounds"
expected="says: Wird gebaut. Bleib bei deiner Arbeit; die Leertaste nur zum Aufgeben. sound: train sound: stopped "
if [ "$(grep -E '^(says|sound):' "$out/packed.log" | tr '\n' ' ')" != "$expected" ]; then
    cat "$out/packed.log"
    echo "bin/test: packed: the data file didn't speak German and play the train"
    exit 1
fi
# The package and the project must agree on the version.
pkgver=$(sed -n 's/^pkgver=//p' pkgbuild/PKGBUILD)
if [ -z "$pkgver" ] || [ "$pkgver" != "$(sed -n 's/^config\/version="\(.*\)"/\1/p' project.godot)" ]; then
    echo "bin/test: pkgver in pkgbuild/PKGBUILD and config/version in project.godot differ"
    exit 1
fi
# A snowy session, given up: the falling snow starts and stops cleanly.
run snowy env AIRSHIP_WEATHER=snow AIRSHIP_SOUND_VOLUME=0 timeout 60 godot --headless --path . --audio-driver Dummy \
    -- --build=0 --give-up-at=2 --quit-at=4
# Throwaway prototypes: parsed and run briefly, never looked at.
run break-task godot --headless --path . --quit-after 5 res://prototypes/break_task/break_task.tscn -- --sessions=3
run airship-mockup godot --headless --path . --quit-after 5 res://prototypes/airship_mockup/airship_mockup.tscn -- --built=0.9
run arm-steam godot --headless --path . --quit-after 5 res://prototypes/arm_steam/arm_steam.tscn -- --minute=17

if ! command -v xvfb-run >/dev/null; then
    echo "bin/test: needs xvfb-run (sudo pacman -S xorg-server-xvfb) to draw a frame off the desktop"
    exit 1
fi
# Silent audio: CI has no sound device, and the tests never play sound aloud.
# No input method: the desktop's (XMODIFIERS, fcitx on Omarchy) isn't running
# on the virtual display, and Godot warns when it can't reach it.
# The frame: midsummer noon in clear weather, ten minutes into a session, so
# the check knows the sky's colour and the arm is at work.
run frame env -u XMODIFIERS AIRSHIP_DATE=2026-06-21 AIRSHIP_TIME=12:30 AIRSHIP_WEATHER=clear \
    timeout 120 xvfb-run -a godot --path . --display-driver x11 --rendering-driver opengl3 --audio-driver Dummy \
    -- --build=600 --check --shot="$PWD/$out/frame.png"
# The launch, pinned as the airship passes the door: both halves are drawn.
run launch env -u XMODIFIERS AIRSHIP_DATE=2026-06-21 AIRSHIP_TIME=12:30 AIRSHIP_WEATHER=clear \
    timeout 120 xvfb-run -a godot --path . --display-driver x11 --rendering-driver opengl3 --audio-driver Dummy \
    -- --passing=launch:8 --shot="$PWD/$out/launch.png"
# A garden five sessions old, so the night train offers a trade and an
# airship brings the first commission: the train stands at the station and
# the airship is moored (the words still ask for the parts to be collected first).
cat >"$out/trade.json" <<'GARDEN'
{"version": 1, "plants": [{"blueprint": 2, "seed": 1, "outcome": "built", "season": "summer", "weather": "clear", "progress": 1.0, "when": "2026-06-10T10:00:00", "minutes": 25}, {"blueprint": 3, "seed": 2, "outcome": "built", "season": "summer", "weather": "clear", "progress": 1.0, "when": "2026-06-11T10:00:00", "minutes": 25}, {"blueprint": 2, "seed": 3, "outcome": "built", "season": "summer", "weather": "clear", "progress": 1.0, "when": "2026-06-12T10:00:00", "minutes": 25}, {"blueprint": 3, "seed": 4, "outcome": "built", "season": "summer", "weather": "clear", "progress": 1.0, "when": "2026-06-13T10:00:00", "minutes": 25}, {"blueprint": 0, "seed": 5, "outcome": "built", "season": "summer", "weather": "clear", "progress": 1.0, "when": "2026-06-14T10:00:00", "minutes": 25}]}
GARDEN
run trade env -u XMODIFIERS AIRSHIP_GARDEN="$PWD/$out/trade.json" AIRSHIP_DATE=2026-06-21 AIRSHIP_TIME=23:30 AIRSHIP_WEATHER=clear \
    timeout 120 xvfb-run -a godot --path . --display-driver x11 --rendering-driver opengl3 --audio-driver Dummy \
    -- --log-words --shot="$PWD/$out/trade.png"
if ! grep -qx 'train: standing' "$out/trade.log" || ! grep -qx 'visitor: 0' "$out/trade.log"; then
    cat "$out/trade.log"
    echo "bin/test: trade: the train isn't standing at the station, or the visiting airship isn't moored"
    exit 1
fi
# A garden where commissions have been met, at night: pennants hang under
# the door's lintel. Five sessions, then forty more of the four quick
# plants in turn, in weather that changes every fourth.
{
    printf '{"version":1,"plants":['
    n=0
    while [ "$n" -lt 45 ]; do
        weather=fog
        if [ "$n" -ge 5 ]; then
            case $(( (n / 4) % 3 )) in 0) weather=cloudy ;; 1) weather=clear ;; *) weather=rain ;; esac
        fi
        [ "$n" -gt 0 ] && printf ','
        printf '{"blueprint":%d,"seed":%d,"outcome":"built","season":"spring","weather":"%s","progress":1.0,"when":"2026-04-%02dT10:00:00","minutes":25}' \
            $(( n % 4 )) $(( n + 1 )) "$weather" $(( n / 2 + 1 ))
        n=$(( n + 1 ))
    done
    printf ']}\n'
} >"$out/pennants.json"
run pennants env -u XMODIFIERS AIRSHIP_GARDEN="$PWD/$out/pennants.json" AIRSHIP_DATE=2026-04-28 AIRSHIP_TIME=23:30 AIRSHIP_WEATHER=clear \
    timeout 120 xvfb-run -a godot --path . --display-driver x11 --rendering-driver opengl3 --audio-driver Dummy \
    -- --log-words --shot="$PWD/$out/pennants.png"
if ! grep -qE '^pennants: [1-9]' "$out/pennants.log"; then
    cat "$out/pennants.log"
    echo "bin/test: pennants: no commission was met, so no pennant was drawn"
    exit 1
fi
echo "bin/test: passed; the frame is $out/frame.png"
