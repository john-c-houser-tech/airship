#!/bin/sh
# Airship's checks. Nothing here opens a window on the desktop: the first two
# steps run headless, and the frame is drawn on a virtual X display.
#   1. import the project
#   2. run the main scene headless for a few frames, so every script parses
#   3. draw a frame under xvfb-run, save it and check two pixels
# Godot keeps going after most errors, so any ERROR or WARNING line in its
# output fails the run, except the one below.
set -eu
cd "$(dirname "$0")/.."
out=build/test
rm -rf "$out"
mkdir -p "$out"
# Godot's own files (logs, editor settings) go here, never in the home folder.
export XDG_DATA_HOME="$PWD/$out/xdg/data" XDG_CONFIG_HOME="$PWD/$out/xdg/config" XDG_CACHE_HOME="$PWD/$out/xdg/cache"

vsync='WARNING: Could not set V-Sync mode, as changing V-Sync mode is not supported by the graphics driver.'

run() { # name, then the command
    name=$1
    shift
    if ! "$@" >"$out/$name.log" 2>&1; then
        cat "$out/$name.log"
        echo "bin/test: $name failed"
        exit 1
    fi
    # A virtual X display can't change V-Sync; the desktop can. That warning
    # is the display's, not Airship's, so it alone is let through.
    if grep -E 'ERROR|WARNING' "$out/$name.log" | grep -vxF "$vsync"; then
        echo "bin/test: $name: Godot reported the problems above"
        exit 1
    fi
}

run import godot --headless --path . --import
run parse godot --headless --path . --quit-after 5
# Throwaway prototypes: parsed and run briefly, never looked at.
run break-task godot --headless --path . --quit-after 5 res://prototypes/break_task/break_task.tscn -- --sessions=3
run airship-mockup godot --headless --path . --quit-after 5 res://prototypes/airship_mockup/airship_mockup.tscn -- --built=0.9
run arm-steam godot --headless --path . --quit-after 5 res://prototypes/arm_steam/arm_steam.tscn -- --minute=17

if ! command -v xvfb-run >/dev/null; then
    echo "bin/test: needs xvfb-run (sudo pacman -S xorg-server-xvfb) to draw a frame off the desktop"
    exit 1
fi
# Silent audio: CI has no sound device, and the tests never play sound aloud.
# No input method: the desktop's (XMODIFIERS, fcitx on Omarchy) isn't running
# on the virtual display, and Godot warns when it can't reach it.
run frame env -u XMODIFIERS xvfb-run -a godot --path . --display-driver x11 --rendering-driver opengl3 --audio-driver Dummy -- --shot="$PWD/$out/frame.png"
echo "bin/test: passed; the frame is $out/frame.png"
